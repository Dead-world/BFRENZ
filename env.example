# Postgres connection string. On Vercel, adding a Neon database from the
# Storage tab fills this in for you automatically.
DATABASE_URL="postgresql://user:password@host:5432/bfrenz?sslmode=require"

# Any long random string (32+ characters). Signs login cookies.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Filled in automatically on Vercel when you create a Blob store.
# Needed for photo and song uploads (users can still paste links without it).
BLOB_READ_WRITE_TOKEN=""

# Optional: the username of your own account. Every new member is
# automatically added as your friend (like the "first friend" everyone had).
FOUNDER_USERNAME=""
